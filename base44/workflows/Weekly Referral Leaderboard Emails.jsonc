{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_referral_leaderboard_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_leaderboard_emails": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyLeaderboardEmails",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly leaderboard emails",
            "description": "Email top 10 referrers their rank and count"
          }
        }
      }
    ]
  },
  "description": "Every Monday morning, emails the top 10 referrers their current rank and total referral count.",
  "name": "Weekly Referral Leaderboard Emails",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "Africa/Lagos",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}