{
  "name": "Commitment Status Notification",
  "description": "Emails the participant when their commitment status changes.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Commitment",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.changed_fields | index(\"status\") != null }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "commitment_status_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyCommitmentStatusChange",
            "args": {
              "commitment_id": "${ .trigger.entity_id }",
              "plan_name": "${ .trigger.data.plan_name }",
              "old_status": "${ .trigger.old_data.status }",
              "new_status": "${ .trigger.data.status }",
              "amount": "${ .trigger.data.amount }",
              "user_id": "${ .trigger.data.created_by_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify participant",
            "description": "Send status-change email"
          }
        }
      }
    ]
  }
}