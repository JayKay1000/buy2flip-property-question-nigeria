{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_reward_processing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_reward": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReferralReward",
            "args": {
              "referralId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verify referrer & apply reward",
            "description": "Check verification, apply reward, email referrer"
          }
        }
      }
    ]
  },
  "name": "Referral Reward Processing",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Referral"
    }
  },
  "description": "When a new referral is recorded, verifies the referrer's account is active. If verified, applies the referral reward and sends a congratulatory notification email."
}