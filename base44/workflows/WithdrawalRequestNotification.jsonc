{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "WithdrawalRequest"
    }
  },
  "name": "Withdrawal Request Notification",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "withdrawal_request_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_admin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyWithdrawalRequested",
            "args": {
              "withdrawal_id": "${ .trigger.entity_id }",
              "amount": "${ .trigger.data.amount }",
              "bank_name": "${ .trigger.data.bank_name }",
              "account_number": "${ .trigger.data.account_number }",
              "account_name": "${ .trigger.data.account_name }",
              "user_id": "${ .trigger.data.created_by_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify admin of withdrawal",
            "description": "Email admins about the new withdrawal request"
          }
        }
      }
    ]
  },
  "description": "Emails all admins the moment a participant submits a new withdrawal request."
}