{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "commitment_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "maturity",
        "welcome_package",
        "referral"
      ],
      "default": "maturity"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "processing",
        "paid",
        "rejected"
      ],
      "default": "requested"
    },
    "bank_name": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amount"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}