{
  "name": "Commitment",
  "type": "object",
  "properties": {
    "plan_name": {
      "type": "string",
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum"
      ]
    },
    "plan_duration_months": {
      "type": "number"
    },
    "plan_return_rate": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "expected_return": {
      "type": "number"
    },
    "total_expected_value": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "maturity_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "active",
        "completed",
        "cancelled",
        "void"
      ],
      "default": "pending_payment"
    },
    "certificate_url": {
      "type": "string"
    },
    "welcome_package_withdrawn": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "plan_name",
    "amount"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}