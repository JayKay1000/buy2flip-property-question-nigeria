{
  "name": "LoginActivity",
  "type": "object",
  "properties": {
    "device": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "location": {
      "type": "string"
    }
  },
  "required": [
    "device",
    "browser"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}