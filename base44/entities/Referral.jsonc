{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_code": {
      "type": "string"
    },
    "referrer_user_id": {
      "type": "string"
    },
    "referred_name": {
      "type": "string"
    },
    "referred_email": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "enum": [
        1,
        2
      ]
    },
    "reward_percentage": {
      "type": "number"
    },
    "reward_amount": {
      "type": "number"
    },
    "commitment_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending"
    },
    "withdrawn": {
      "type": "boolean",
      "default": false
    },
    "withdrawn_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "referrer_code",
    "level"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}